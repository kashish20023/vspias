# VSPIAS Ecoautomation Environment Variables Template
# Copy this file to .env.local for local development.
# Configure these variables in Vercel Dashboard -> Settings -> Environment Variables.

# Admin Dashboard Access Password (used for /admin authentication)
ADMIN_PASSWORD=vspias@admin2026

# Site Base URL (used for dynamic sitemap.xml and robots.txt generation)
# Default: https://vspias.in
NEXT_PUBLIC_SITE_URL=https://vspias.in

# Google Apps Script Web App URL for direct Enquiry Form submissions to Google Sheets
# Deploy your Google Apps Script as a Web App (Execute as: Me, Access: Anyone) and paste the exec URL here:
# NEXT_PUBLIC_GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Password: vspias@admin2026